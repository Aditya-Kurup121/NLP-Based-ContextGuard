# ContextGuard Configuration
# Backend bind address (used by `python -m backend.app.main`)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API (add your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview URLs, e.g. https://contextguard-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=
# Deployment: Hub repo holding the trained weights (see DEPLOY.md)
MODEL_REPO=
# Frontend API base URL (read by Vite at build/dev time)
VITE_API_URL=http://127.0.0.1:8000/api

# Optional hosted second opinion. Never put tokens in VITE_* variables.
# Choose an available chat model from https://huggingface.co/playground
HF_TOKEN=
HF_CHAT_MODEL=
